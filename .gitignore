# General ignores
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json # Allow sharing VS Code extensions

# Server-specific ignores
/server/node_modules
/server/.env
/server/build
/server/dist
/server/*.log
/server/npm-debug.log*
/server/yarn-debug.log*
/server/yarn-error.log*
/server/pnpm-debug.log*
/server/lerna-debug.log*

# Client-specific ignores
/client/node_modules
/client/.env
/client/build
/client/dist
/client/coverage
/client/*.local
/client/logs
/client/*.log
/client/npm-debug.log*
/client/yarn-debug.log*
/client/yarn-error.log*
/client/pnpm-debug.log*
/client/lerna-debug.log*
/client/*.tsbuildinfo
/client/.eslintcache
/client/*.timestamp-*-*.mjs
